{
  "year": "Shell",
  "topicNumber": 1,
  "topicTitle": "Basic Algebra",
  "skills": {
    "Simplifying by collecting like terms": {
      "items": [
        {
          "q": "Simplify: 3x + 5 - 2x + 7",
          "a": "x + 12",
          "hints": [
            "Group the x-terms together and the number terms together.",
            "(3x - 2x) + (5 + 7).",
            "x + 12"
          ]
        },
        {
          "q": "Simplify: 4a - 3b + 6a + b",
          "a": "10a - 2b",
          "hints": [
            "Group the a-terms together and the b-terms together.",
            "(4a + 6a) + (-3b + b).",
            "10a - 2b"
          ]
        },
        {
          "q": "Simplify: 2p + 3q - 5p + 8 - q",
          "a": "-3p + 2q + 8",
          "hints": [
            "Group the p-terms, the q-terms, and the number terms.",
            "(2p - 5p) + (3q - q) + 8.",
            "-3p + 2q + 8"
          ]
        },
        {
          "q": "Simplify: 9m - 4 + 2m + 11",
          "a": "11m + 7",
          "hints": [
            "Group the m-terms together and the number terms together.",
            "(9m + 2m) + (-4 + 11).",
            "11m + 7"
          ]
        },
        {
          "q": "Simplify: 7y - 3x + 5y + x",
          "a": "12y - 2x",
          "hints": [
            "Group the y-terms together and the x-terms together.",
            "(7y + 5y) + (-3x + x).",
            "12y - 2x"
          ]
        },
        {
          "q": "Simplify: 6r + 8 - 2r - 3 + r",
          "a": "5r + 5",
          "hints": [
            "Group the r-terms together and the number terms together.",
            "(6r - 2r + r) + (8 - 3).",
            "5r + 5"
          ]
        }
      ]
    },
    "Multiplying out:": {
      "items": [
        {
          "q": "Expand: 4(x + 3)",
          "a": "4x + 12",
          "hints": [
            "Multiply the outside number by every term inside the bracket.",
            "4 x x, and 4 x 3.",
            "4x + 12"
          ]
        },
        {
          "q": "Expand: -2(3y - 5)",
          "a": "-6y + 10",
          "hints": [
            "Multiply the outside number by every term inside the bracket — watch the signs carefully.",
            "-2 x 3y, and -2 x -5.",
            "-6y + 10"
          ]
        },
        {
          "q": "Expand: 5(a - 2b + 1)",
          "a": "5a - 10b + 5",
          "hints": [
            "Multiply the outside number by every term inside the bracket.",
            "5 x a, 5 x -2b, and 5 x 1.",
            "5a - 10b + 5"
          ]
        },
        {
          "q": "Expand: 3(2m + n)",
          "a": "6m + 3n",
          "hints": [
            "Multiply the outside number by every term inside the bracket.",
            "3 x 2m, and 3 x n.",
            "6m + 3n"
          ]
        },
        {
          "q": "Expand: -4(p - q + 2)",
          "a": "-4p + 4q - 8",
          "hints": [
            "Multiply the outside number by every term inside the bracket — watch the signs carefully.",
            "-4 x p, -4 x -q, and -4 x 2.",
            "-4p + 4q - 8"
          ]
        },
        {
          "q": "Expand: 6(r + 2s - 1)",
          "a": "6r + 12s - 6",
          "hints": [
            "Multiply the outside number by every term inside the bracket.",
            "6 x r, 6 x 2s, and 6 x -1.",
            "6r + 12s - 6"
          ]
        }
      ]
    },
    "1 bracket with constant term": {
      "items": [
        {
          "q": "Expand: 7(x - 4)",
          "a": "7x - 28",
          "hints": [
            "Multiply the outside number by every term inside the bracket.",
            "7 x x, and 7 x -4.",
            "7x - 28"
          ]
        },
        {
          "q": "Expand: -3(2x + 1)",
          "a": "-6x - 3",
          "hints": [
            "Multiply the outside number by every term inside the bracket — watch the signs carefully.",
            "-3 x 2x, and -3 x 1.",
            "-6x - 3"
          ]
        },
        {
          "q": "Expand: 9(1 - y)",
          "a": "9 - 9y",
          "hints": [
            "Multiply the outside number by every term inside the bracket.",
            "9 x 1, and 9 x -y.",
            "9 - 9y"
          ]
        },
        {
          "q": "Expand: -5(a - 3)",
          "a": "-5a + 15",
          "hints": [
            "Multiply the outside number by every term inside the bracket — watch the signs carefully.",
            "-5 x a, and -5 x -3.",
            "-5a + 15"
          ]
        },
        {
          "q": "Expand: 8(2 - b)",
          "a": "16 - 8b",
          "hints": [
            "Multiply the outside number by every term inside the bracket.",
            "8 x 2, and 8 x -b.",
            "16 - 8b"
          ]
        },
        {
          "q": "Expand: 4(3p + 2)",
          "a": "12p + 8",
          "hints": [
            "Multiply the outside number by every term inside the bracket.",
            "4 x 3p, and 4 x 2.",
            "12p + 8"
          ]
        }
      ]
    },
    "2 brackets (‘FOIL’)": {
      "items": [
        {
          "q": "Expand: (x + 4)(x + 1)",
          "a": "x^2 + 5x + 4",
          "hints": [
            "Use FOIL: First, Outer, Inner, Last, then collect like terms.",
            "x·x + x·1 + 4·x + 4·1.",
            "x^2 + x + 4x + 4 = x^2 + 5x + 4"
          ]
        },
        {
          "q": "Expand: (x - 3)(x + 5)",
          "a": "x^2 + 2x - 15",
          "hints": [
            "Use FOIL: First, Outer, Inner, Last, then collect like terms.",
            "x·x + x·5 + -3·x + -3·5.",
            "x^2 + 5x - 3x - 15 = x^2 + 2x - 15"
          ]
        },
        {
          "q": "Expand: (2x + 1)(x - 2)",
          "a": "2x^2 - 3x - 2",
          "hints": [
            "Use FOIL: First, Outer, Inner, Last, then collect like terms.",
            "2x·x + 2x·-2 + 1·x + 1·-2.",
            "2x^2 - 4x + x - 2 = 2x^2 - 3x - 2"
          ]
        },
        {
          "q": "Expand: (x + 7)(x - 2)",
          "a": "x^2 + 5x - 14",
          "hints": [
            "Use FOIL: First, Outer, Inner, Last, then collect like terms.",
            "x·x + x·-2 + 7·x + 7·-2.",
            "x^2 - 2x + 7x - 14 = x^2 + 5x - 14"
          ]
        },
        {
          "q": "Expand: (3x - 1)(x + 4)",
          "a": "3x^2 + 11x - 4",
          "hints": [
            "Use FOIL: First, Outer, Inner, Last, then collect like terms.",
            "3x·x + 3x·4 + -1·x + -1·4.",
            "3x^2 + 12x - x - 4 = 3x^2 + 11x - 4"
          ]
        },
        {
          "q": "Expand: (2x - 5)(x - 3)",
          "a": "2x^2 - 11x + 15",
          "hints": [
            "Use FOIL: First, Outer, Inner, Last, then collect like terms.",
            "2x·x + 2x·-3 + -5·x + -5·-3.",
            "2x^2 - 6x - 5x + 15 = 2x^2 - 11x + 15"
          ]
        }
      ]
    },
    "3 brackets": {
      "items": [
        {
          "q": "Expand: (x + 1)(x + 2)(x + 3)",
          "a": "x^3 + 6x^2 + 11x + 6",
          "hints": [
            "Multiply the first two brackets together first, then multiply that result by the third bracket.",
            "(x + 1)(x + 2) = x^2 + 3x + 2.",
            "(x^2 + 3x + 2)(x + 3) = x^3 + 6x^2 + 11x + 6"
          ]
        },
        {
          "q": "Expand: (x - 1)(x + 2)(x + 4)",
          "a": "x^3 + 5x^2 + 2x - 8",
          "hints": [
            "Multiply the first two brackets together first, then multiply that result by the third bracket.",
            "(x - 1)(x + 2) = x^2 + x - 2.",
            "(x^2 + x - 2)(x + 4) = x^3 + 5x^2 + 2x - 8"
          ]
        },
        {
          "q": "Expand: (2x + 1)(x - 1)(x + 3)",
          "a": "2x^3 + 5x^2 - 4x - 3",
          "hints": [
            "Multiply the first two brackets together first, then multiply that result by the third bracket.",
            "(2x + 1)(x - 1) = 2x^2 - x - 1.",
            "(2x^2 - x - 1)(x + 3) = 2x^3 + 5x^2 - 4x - 3"
          ]
        },
        {
          "q": "Expand: (x + 2)(x + 2)(x - 1)",
          "a": "x^3 + 3x^2 - 4",
          "hints": [
            "Multiply the first two brackets together first, then multiply that result by the third bracket.",
            "(x + 2)(x + 2) = x^2 + 4x + 4.",
            "(x^2 + 4x + 4)(x - 1) = x^3 + 3x^2 - 4"
          ]
        },
        {
          "q": "Expand: (x - 2)(x - 1)(x + 5)",
          "a": "x^3 + 2x^2 - 13x + 10",
          "hints": [
            "Multiply the first two brackets together first, then multiply that result by the third bracket.",
            "(x - 2)(x - 1) = x^2 - 3x + 2.",
            "(x^2 - 3x + 2)(x + 5) = x^3 + 2x^2 - 13x + 10"
          ]
        },
        {
          "q": "Expand: (2x - 1)(x + 1)(x + 2)",
          "a": "2x^3 + 5x^2 + x - 2",
          "hints": [
            "Multiply the first two brackets together first, then multiply that result by the third bracket.",
            "(2x - 1)(x + 1) = 2x^2 + x - 1.",
            "(2x^2 + x - 1)(x + 2) = 2x^3 + 5x^2 + x - 2"
          ]
        }
      ]
    },
    "Factorising by taking out a common factor": {
      "items": [
        {
          "q": "Factorise: 12x + 18",
          "a": "6(2x + 3)",
          "hints": [
            "Find the biggest number that divides every term, then divide each term by it.",
            "12 and 18 share a factor of 6: 12x/6 = 2x, 18/6 = 3.",
            "6(2x + 3)"
          ]
        },
        {
          "q": "Factorise: 15a^2b - 20ab",
          "a": "5ab(3a - 4)",
          "hints": [
            "Find the biggest number and letter factor shared by every term, then divide each term by it.",
            "15a²b and 20ab share a factor of 5ab: 15a²b/(5ab) = 3a, 20ab/(5ab) = 4.",
            "5ab(3a - 4)"
          ]
        },
        {
          "q": "Factorise: 9y^3 + 6y^2 - 3y",
          "a": "3y(3y^2 + 2y - 1)",
          "hints": [
            "Find the biggest number and letter factor shared by every term, then divide each term by it.",
            "9y³, 6y², and 3y share a factor of 3y: 9y³/3y = 3y², 6y²/3y = 2y, 3y/3y = 1.",
            "3y(3y^2 + 2y - 1)"
          ]
        },
        {
          "q": "Factorise: 14p - 21",
          "a": "7(2p - 3)",
          "hints": [
            "Find the biggest number that divides every term, then divide each term by it.",
            "14 and 21 share a factor of 7: 14p/7 = 2p, 21/7 = 3.",
            "7(2p - 3)"
          ]
        },
        {
          "q": "Factorise: 8m^2n + 12mn",
          "a": "4mn(2m + 3)",
          "hints": [
            "Find the biggest number and letter factor shared by every term, then divide each term by it.",
            "8m²n and 12mn share a factor of 4mn: 8m²n/(4mn) = 2m, 12mn/(4mn) = 3.",
            "4mn(2m + 3)"
          ]
        },
        {
          "q": "Factorise: 5x^3 - 10x^2 + 15x",
          "a": "5x(x^2 - 2x + 3)",
          "hints": [
            "Find the biggest number and letter factor shared by every term, then divide each term by it.",
            "5x³, 10x², and 15x share a factor of 5x: 5x³/5x = x², 10x²/5x = 2x, 15x/5x = 3.",
            "5x(x^2 - 2x + 3)"
          ]
        }
      ]
    }
  }
}
